  isolamentoAdequado   String @default("Sim") @map("isolamento_adequado") @db.VarChar(10)
  usoEpiAdequado       String @default("Sim") @map("uso_epi_adequado") @db.VarChar(10)
  higienizacaoAdequada String @default("Sim") @map("higienizacao_adequada") @db.VarChar(10)

  // Orientações fornecidas
  orientacoesRepassadas String? @map("orientacoes_repassadas")

  // Avaliação e próximos passos
  observacoesGerais     String?   @map("observacoes_gerais")
  necessidadeNovaVisita String    @default("Sim") @map("necessidade_nova_visita") @db.VarChar(10)
  dataProximaVisita     DateTime? @map("data_proxima_visita") @db.Date

  // Encaminhamentos
  encVeterinario           Boolean @default(false) @map("enc_veterinario")
  encNotificacao           Boolean @default(false) @map("enc_notificacao")
  encOutros                Boolean @default(false) @map("enc_outros")
  descricaoEncaminhamentos String? @map("descricao_encaminhamentos")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  visita EsporotricoseVisita @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  @@index([visitaId], map: "idx_relatorio_visita")
  @@map("ccz_esporotricose_relatorios")
}

model UserAcesso {
  id           Int           @id @default(autoincrement())
  userCpf      String        @map("user_cpf") @db.VarChar(11)
  modulo       ModuloAcesso
  nivel        NivelAcesso
  servicoJunta ServicoJunta? @map("servico_junta")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userCpf], references: [cpf], onDelete: Cascade, map: "fk_user_acesso_user")

  // ── Modelo por módulo (evolução aditiva; ver PROPOSTA-CONTROLE-DE-ACESSO) ──
  // perfil: conjunto nomeado de permissões daquele módulo. NULL = vínculo
  // anterior à migração, interpretado a partir de `nivel` (convivência).
  perfil        PerfilModulo? @default(ADMINISTRADOR)
  // escopo + servicos: juntos definem o alcance do vínculo.
  //   TODOS       → todos os serviços do módulo (servicos deve ficar vazio)
  //   ESPECIFICOS → somente os de `servicos` (não pode ficar vazio)
  //   NENHUM      → nenhum serviço (servicos deve ficar vazio)
  escopo        EscopoServico @default(TODOS)
  servicos      String[]      @default([])
  // permissoes: CONCESSÕES ADICIONAIS fora do pacote do perfil, no formato
  // "funcionalidade:permissao". removidas: RETIRADAS do pacote do perfil.
  //   efetivas = (pacote do perfil ∪ permissoes) − removidas
  removidas     String[]      @default([])
  // Vazio = pacote padrão do perfil (resolvido em código, ver lib/permissoesCatalogo).
  permissoes    String[]      @default([])
  // ativo: desliga o vínculo sem apagar o histórico.
  ativo         Boolean       @default(true)
  // Rastreabilidade de quem concedeu/alterou o vínculo.
  atualizadoPor String?       @map("atualizado_por") @db.VarChar(11)
  atualizadoEm  DateTime?     @map("atualizado_em") @db.Timestamptz(6)

  @@unique([userCpf, modulo, nivel, servicoJunta], map: "idx_user_acesso_unico")
  @@index([userCpf], map: "idx_user_acesso_cpf")
  @@index([userCpf, modulo], map: "idx_user_acesso_cpf_modulo")
  @@map("user_acessos")
}

enum Role {
  GESTOR
  REGULACAO_ADMIN
  REGULACAO_COMUM
  FARMACIA_ADMIN
  PROCESSO_ADMIN
  JUNTA_ADMIN
  JUNTA_CAEE
  JUNTA_EDUCACAO
  JUNTA_SAUDE
  JUNTA_ASSISTENCIA
  CCZ_ADMIN
  CCZ_COMUM
}

enum ModuloAcesso {
  REGULACAO
  FARMACIA
  PROCESSOS
  JUNTA
  CCZ
  // Gestão Geral: permissões administrativas próprias, sem acesso operacional
  // automático aos módulos.
  GESTAO
}

// Escopo de serviços do vínculo. Explícito de propósito: vazio nunca significa
// "todos" — TODOS precisa ser declarado.
enum EscopoServico {
  TODOS
  ESPECIFICOS
  NENHUM
}

enum NivelAcesso {
  ADMIN
  OPERADOR
}

// Perfis por módulo (modelo Módulo → Perfil → Serviço → Funcionalidade → Permissão).
// Não há hierarquia rígida: cada perfil tem um pacote explícito de permissões.
enum PerfilModulo {
  ADMINISTRADOR
  SUPERVISOR
  OPERADOR
  CONSULTA
  AUDITOR
}

enum ServicoJunta {
  CAEE
  APAE
  AMBULATORIO
  ESPECIALIDADES
}

