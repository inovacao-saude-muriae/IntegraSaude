  // Condição clínica observada
  apresentaLesoes String  @default("Não") @map("apresenta_lesoes") @db.VarChar(10)
  descricaoLesoes String? @map("descricao_lesoes")
  evolucaoQuadro  String? @map("evolucao_quadro") @db.VarChar(50)

  // Tratamento atual
  emTratamento       String  @default("Sim") @map("em_tratamento") @db.VarChar(10)
  medicamentosAtuais String? @map("medicamentos_atuais")
  adesaoTratamento   String? @map("adesao_tratamento") @db.VarChar(50)

