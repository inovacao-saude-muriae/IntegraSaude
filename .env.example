# =============================================================================
# IntegraSaude - modelo de variaveis de ambiente
# Copie para .env (ou .env.local) e preencha. NUNCA commite o arquivo real.
# =============================================================================

# [OBRIGATORIA] URL de conexao do PostgreSQL usada pela aplicacao e pelo Prisma.
# Se o banco exigir SSL (externo/gerenciado), acrescente ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/integrasaude?schema=public"

# [OPCIONAL] Conexao direta ao banco, usada pelo Prisma CLI (migrate).
# Se nao definida, deixe vazia ou igual a DATABASE_URL.
DIRECT_URL="postgresql://USUARIO:SENHA@localhost:5432/integrasaude?schema=public"

# [OBRIGATORIA] Segredo para assinar a sessao (JWT). Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# [OBRIGATORIAS para o seed em producao] Usuario Gestor inicial (npx prisma db seed).
# Em producao o seed aborta se GESTOR_USERNAME ou GESTOR_SENHA nao estiverem definidos.
GESTOR_USERNAME="gestor"
GESTOR_NOME="Administrador"
GESTOR_SENHA="defina-uma-senha-forte"

# [OPCIONAL] Porta HTTP do "next start" (padrao 3000).
PORT=3000

# [OBRIGATORIA em producao] Use "production" na VPS (ativa cookie Secure, exige HTTPS).
# Em desenvolvimento o "next dev" define "development" automaticamente.
NODE_ENV=production